DATABASE_URL="postgresql://postgres:password@localhost:5432/cellon?schema=public"
APP_URL="http://localhost:3000"

# Set only on the first seed run. Choose a unique email and strong password.
ADMIN_NAME="Platform Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# SMTP is required to send account activation and rejection emails.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CellOn <no-reply@example.com>"
