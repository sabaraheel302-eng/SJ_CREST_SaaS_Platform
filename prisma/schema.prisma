generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFORMATION_REQUIRED
  ACTIVATION_PENDING
  ACTIVATED
}

enum DemoStatus {
  PENDING
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SubscriptionStatus {
  PENDING
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum SerialStatus {
  AVAILABLE
  ASSIGNED
  REVOKED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PlatformRole {
  NONE
  SUPER_ADMIN
  ADMIN
  SUPPORT_ADMIN
  BILLING_ADMIN
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum DeviceStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  DAMAGED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model AccountRequest {
  id                  String        @id @default(uuid()) @db.Uuid
  requestNumber       String        @unique @default(cuid())
  businessName        String
  ownerName           String
  email               String
  phone               String
  country             String
  city                String
  businessType        String
  branchCount         Int           @default(1)
  employeeCount       Int           @default(1)
  preferredPlanId     String?       @db.Uuid
  additionalDetails   String?       @db.Text
  status              RequestStatus @default(PENDING)
  internalNotes       String?       @db.Text
  reviewedAt          DateTime?
  approvedById        String?       @db.Uuid
  provisionedTenantId String?       @unique @db.Uuid
  rejectionReason     String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  preferredPlan       Plan?         @relation(fields: [preferredPlanId], references: [id], onDelete: SetNull)
  approvedBy          User?         @relation("RequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  provisionedTenant   Tenant?       @relation("ProvisionedTenant", fields: [provisionedTenantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
}

model DemoRequest {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  businessName  String
  email         String
  phone         String
  country       String
  city          String
  preferredPlan String?
  preferredAt   DateTime?
  message       String?    @db.Text
  status        DemoStatus @default(PENDING)
  internalNotes String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Tenant {
  id                 String            @id @default(uuid()) @db.Uuid
  serialNumberId     String?           @unique @db.Uuid
  name               String
  slug               String            @unique
  status             TenantStatus      @default(PENDING)
  country            String?
  city               String?
  phone              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  serialNumber       SerialNumber?     @relation(fields: [serialNumberId], references: [id], onDelete: SetNull)
  memberships        TenantUser[]
  branches           Branch[]
  subscriptions      Subscription[]
  products           Product[]
  imeiDevices        IMEIDevice[]
  imeiIdentifiers    IMEIIdentifier[]
  customers          Customer[]
  suppliers          Supplier[]
  sales              SalesInvoice[]
  purchases          PurchaseInvoice[]
  payments           Payment[]
  expenses           Expense[]
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  supportTickets     SupportTicket[]
  notifications      Notification[]
  originatingRequest AccountRequest?   @relation("ProvisionedTenant")

  @@index([status, createdAt])
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique
  name             String
  passwordHash     String
  status           UserStatus        @default(INVITED)
  platformRole     PlatformRole      @default(NONE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      TenantUser[]
  auditLogs        AuditLog[]
  sessions         AuthSession[]
  activationTokens ActivationToken[]
  reviewedRequests AccountRequest[]  @relation("RequestApprover")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ActivationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RateLimitBucket {
  key             String   @id
  hits            Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  permissions RolePermission[]
  memberships TenantUser[]
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model TenantUser {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  branchId  String?  @db.Uuid
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, branchId])
}

model Plan {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  priceMonthly    Decimal          @default(0) @db.Decimal(12, 2)
  currency        String           @default("PKR")
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  features        PlanFeature[]
  subscriptions   Subscription[]
  accountRequests AccountRequest[]
}

model PlanFeature {
  id      String  @id @default(uuid()) @db.Uuid
  planId  String  @db.Uuid
  key     String
  enabled Boolean @default(true)
  limit   Int?
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  planId     String             @db.Uuid
  status     SubscriptionStatus @default(TRIAL)
  startsAt   DateTime           @default(now())
  endsAt     DateTime?
  termMonths Int                @default(1)
  createdAt  DateTime           @default(now())
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan       Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, endsAt])
}

model SerialNumber {
  id         String       @id @default(uuid()) @db.Uuid
  value      String       @unique
  status     SerialStatus @default(AVAILABLE)
  assignedAt DateTime?
  createdAt  DateTime     @default(now())
  tenant     Tenant?

  @@index([status, createdAt])
}

model Branch {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  name      String
  address   String?
  phone     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   TenantUser[]
  products  Product[]
  imeis     IMEIDevice[]
  customers Customer[]
  suppliers Supplier[]
  sales     SalesInvoice[]
  purchases PurchaseInvoice[]
  expenses  Expense[]
  movements StockMovement[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Product {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  branchId      String?         @db.Uuid
  name          String
  sku           String?
  brand         String?
  category      String?
  trackImei     Boolean         @default(false)
  archivedAt    DateTime?
  costPrice     Decimal         @default(0) @db.Decimal(12, 2)
  salePrice     Decimal         @default(0) @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  imeis         IMEIDevice[]
  stockMoves    StockMovement[]
  salesItems    SalesItem[]
  purchaseItems PurchaseItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, branchId, name])
  @@index([tenantId, archivedAt])
}

model IMEIDevice {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  branchId    String?          @db.Uuid
  productId   String           @db.Uuid
  imei        String           @unique
  imei2       String?
  status      DeviceStatus     @default(IN_STOCK)
  costPrice   Decimal?         @db.Decimal(12, 2)
  salePrice   Decimal?         @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  identifiers IMEIIdentifier[]

  @@index([tenantId, branchId, status])
}

model IMEIIdentifier {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  deviceId  String     @db.Uuid
  value     String     @unique
  kind      String
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    IMEIDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId])
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  branchId       String?        @db.Uuid
  name           String
  phone          String?
  email          String?
  address        String?
  creditLimit    Decimal        @default(0) @db.Decimal(12, 2)
  openingBalance Decimal        @default(0) @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sales          SalesInvoice[]
  payments       Payment[]

  @@index([tenantId, name, phone])
}

model Supplier {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  branchId       String?           @db.Uuid
  name           String
  phone          String?
  email          String?
  address        String?
  openingBalance Decimal           @default(0) @db.Decimal(12, 2)
  createdAt      DateTime          @default(now())
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  purchases      PurchaseInvoice[]
  payments       Payment[]

  @@index([tenantId, name, phone])
}

model SalesInvoice {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  branchId   String?       @db.Uuid
  customerId String?       @db.Uuid
  number     String
  status     InvoiceStatus @default(ISSUED)
  subtotal   Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @default(0) @db.Decimal(12, 2)
  createdAt  DateTime      @default(now())
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      SalesItem[]
  payments   Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId, createdAt])
}

model SalesItem {
  id        String       @id @default(uuid()) @db.Uuid
  invoiceId String       @db.Uuid
  productId String       @db.Uuid
  quantity  Int
  unitPrice Decimal      @db.Decimal(12, 2)
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model PurchaseInvoice {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  branchId   String?        @db.Uuid
  supplierId String?        @db.Uuid
  number     String
  status     InvoiceStatus  @default(ISSUED)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier   Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items      PurchaseItem[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId, createdAt])
}

model PurchaseItem {
  id        String          @id @default(uuid()) @db.Uuid
  invoiceId String          @db.Uuid
  productId String          @db.Uuid
  quantity  Int
  unitCost  Decimal         @db.Decimal(12, 2)
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  customerId     String?       @db.Uuid
  supplierId     String?       @db.Uuid
  salesInvoiceId String?       @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         String
  receivedAt     DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  salesInvoice   SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, receivedAt])
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  branchId    String?  @db.Uuid
  category    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  incurredAt  DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, incurredAt])
}

model StockMovement {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  branchId  String?  @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  kind      String
  reference String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  subject   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  recipient String
  kind      String
  payload   Json
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model WebsiteContent {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique
  title       String?
  body        Json
  status      ContentStatus @default(DRAFT)
  version     Int           @default(1)
  publishedAt DateTime?
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())

  @@index([status, updatedAt])
}
